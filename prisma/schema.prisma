generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  password           String
  telegramAccounts   TelegramAccount[]
  telegramLinkTokens TelegramLinkToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  imagePublicId  String?
  imageSecureUrl String?
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Brand {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  logoUrl      String?
  logoPublicId String?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id                 String                     @id @default(cuid())
  name               String
  slug               String                     @unique
  sku                String                     @unique
  barcode            String?                    @unique
  description        String?
  categoryId         String
  category           Category                   @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?                     @relation(fields: [brandId], references: [id])
  quantity           Int                        @default(0)
  minStockLevel      Int                        @default(0)
  price1             Decimal                    @default(0) @db.Decimal(10, 2)
  price2             Decimal                    @default(0) @db.Decimal(10, 2)
  price3             Decimal                    @default(0) @db.Decimal(10, 2)
  purchasePrice      Decimal                    @default(0) @db.Decimal(10, 2)
  weight             Decimal?                   @default(0) @db.Decimal(10, 3)
  status             ProductStatus              @default(ACTIVE)
  images             ProductImage[]
  orderItems         OrderItem[]
  movements          InventoryMovement[]
  purchaseItems      PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]
  telegramDraftItems TelegramInvoiceDraftItem[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  publicId  String
  secureUrl String
  position  Int     @default(0)

  @@index([productId])
}

model Customer {
  id                  String                   @id @default(cuid())
  name                String
  nameNormalized      String
  phone               String
  email               String?
  address             String?
  notes               String?
  balance             Decimal                  @default(0) @db.Decimal(10, 2)
  isFavorite          Boolean                  @default(false)
  orders              Order[]
  invoices            Invoice[]
  balanceHistory      CustomerBalanceHistory[]
  paymentTransactions PaymentTransaction[]
  telegramDrafts      TelegramInvoiceDraft[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  customerEmail String?
  status        OrderStatus @default(PENDING)
  items         OrderItem[]
  total         Decimal     @db.Decimal(10, 2)
  notes         String?
  invoice       Invoice?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  position  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String?
  product   Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  type      InventoryMovementType
  quantity  Int
  reason    String?
  reference String?
  createdAt DateTime              @default(now())

  @@index([productId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  orderNumber   String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  status        PurchaseOrderStatus @default(PENDING)
  language      InvoiceLanguage     @default(AR)
  items         PurchaseOrderItem[]
  total         Decimal             @db.Decimal(10, 2)
  paymentStatus PaymentStatus       @default(UNPAID)
  paidAmount    Decimal             @default(0) @db.Decimal(10, 2)
  payments      SupplierPayment[]
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([supplierId])
}

model SupplierPayment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  note            String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)

  @@index([purchaseOrderId])
  @@index([productId])
}

enum ExpenseCategory {
  RENT
  SALARIES
  TRANSPORTATION
  UTILITIES
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum InvoiceLanguage {
  AR
  FR
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  BALANCE
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Invoice {
  id                   String                @id @default(cuid())
  invoiceNumber        String                @unique
  language             InvoiceLanguage       @default(AR)
  customerId           String?
  customer             Customer?             @relation(fields: [customerId], references: [id])
  customerName         String
  customerPhone        String
  customerEmail        String?
  notes                String?
  orderId              String?               @unique
  order                Order?                @relation(fields: [orderId], references: [id])
  items                InvoiceItem[]
  total                Decimal               @default(0) @db.Decimal(10, 2)
  paymentMethod        PaymentMethod         @default(CASH)
  paymentStatus        PaymentStatus         @default(UNPAID)
  paidAmount           Decimal               @default(0) @db.Decimal(10, 2)
  payments             Payment[]
  paymentTransactions  PaymentTransaction[]
  balanceEffectApplied Decimal               @default(0) @db.Decimal(10, 2)
  mergedDebtAmount     Decimal               @default(0) @db.Decimal(10, 2)
  posSaleToken         String?               @unique
  createdByBot         Boolean               @default(false)
  telegramDraft        TelegramInvoiceDraft?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([customerId])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  note      String?
  batchId   String?
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@index([batchId])
}

model PaymentTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  note      String?

  batchId   String?
  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([invoiceId])
  @@index([batchId])
}

enum BalanceChangeReason {
  INVOICE_PAYMENT
  BALANCE_USED
  OVERPAYMENT_CREDIT
  INVOICE_EDIT
  INVOICE_CANCELLATION
  BALANCE_RETURNED
  MANUAL_ADJUSTMENT
}

model CustomerBalanceHistory {
  id              String              @id @default(cuid())
  customerId      String
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoiceNumber   String?
  previousBalance Decimal             @db.Decimal(10, 2)
  change          Decimal             @db.Decimal(10, 2)
  newBalance      Decimal             @db.Decimal(10, 2)
  reason          BalanceChangeReason
  note            String?
  createdAt       DateTime            @default(now())

  @@index([customerId])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  position  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([productId])
}

enum TelegramDraftStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum TelegramMatchStatus {
  EXACT
  STRONG
  AMBIGUOUS
  NOT_FOUND
}

model TelegramAccount {
  id                   String                 @id @default(cuid())
  telegramUserId       BigInt                 @unique
  adminId              String
  admin                Admin                  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  isActive             Boolean                @default(true)
  linkedAt             DateTime               @default(now())
  drafts               TelegramInvoiceDraft[]
  chatMessages         TelegramChatMessage[]
  conversationSummary  String?
  messagesSinceSummary Int                    @default(0)
  name                 String?
  username             String?

  @@index([adminId])
}

model TelegramChatMessage {
  id                String          @id @default(cuid())
  telegramAccountId String
  telegramAccount   TelegramAccount @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  content           String
  createdAt         DateTime        @default(now())

  @@index([telegramAccountId, createdAt])
}

model TelegramLinkToken {
  id         String    @id @default(cuid())
  token      String    @unique
  adminId    String
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminId])
}

model TelegramInvoiceDraft {
  id                String                     @id @default(cuid())
  token             String                     @unique
  telegramAccountId String
  telegramAccount   TelegramAccount            @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  status            TelegramDraftStatus        @default(PENDING)
  paymentMethod     PaymentMethod?
  paymentAmount     Decimal?                   @db.Decimal(10, 2)
  paidInFull        Boolean                    @default(false)
  respeakItemId     String?
  rawTranscript     String?
  customerId        String?
  customer          Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId         String?                    @unique
  invoice           Invoice?                   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expiresAt         DateTime
  confirmedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  items             TelegramInvoiceDraftItem[]

  @@index([telegramAccountId, status])
}

model TelegramInvoiceDraftItem {
  id               String               @id @default(cuid())
  draftId          String
  draft            TelegramInvoiceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  spokenName       String
  quantity         Int
  matchStatus      TelegramMatchStatus
  matchedProductId String?
  matchedProduct   Product?             @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)

  candidateProductIds String[] @default([])
  position            Int      @default(1)

  @@index([draftId])
  @@index([matchedProductId])
}
