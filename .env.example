# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Seed admin (used once by prisma/seed.ts to create the first مدير النظام)
SEED_ADMIN_NAME="مدير النظام"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Cloudinary (Phase 3 — product image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Required before deleting an invoice, customer, or payment
DELETE_CONFIRM_PASSWORD=""

=""
# uncomment next line if you use Prisma <5.10
# DATABASE_URL_UNPOOLED="postgresql://neondb_owner:npg_F1SBpXjmlt5g@ep-bold-tooth-atie5q33.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Telegram AI voice-invoice bot ---
# Bot token from @BotFather. Server-side only.
TELEGRAM_BOT_TOKEN=""
# Bot @username without the @ (builds the t.me/<bot>?start=... link).
TELEGRAM_BOT_USERNAME=""
# Secret you choose; passed as secret_token to setWebhook. The webhook
# rejects requests whose X-Telegram-Bot-Api-Secret-Token doesn't match.
TELEGRAM_WEBHOOK_SECRET=""
# Groq key — voice transcription (whisper-large-v3). Server-side only.
GROQ_API_KEY=""
# DeepSeek key — intent extraction. Server-side only.
DEEPSEEK_API_KEY=""
# Public https origin of this deployment, no trailing slash (Mini App URL).
APP_URL=""

# Auth.js: trust the Host header. Required when running `next start` (production
# build) locally or behind ngrok, otherwise login fails with "UntrustedHost".
AUTH_TRUST_HOST=true
# Whisper transcription language (ISO code). Default "ar" so Moroccan Darija stays in
# Arabic letters; use "fr" for French-only speech or "auto" to let Whisper detect it.
# WHISPER_LANGUAGE="ar"
